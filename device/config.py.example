# Copy this file to config.py on the device and edit as needed.

DEVICE_NAME = "AIHarnessDesktopBuddy"
HTTP_PORT = 8080

# I2C OLED pins
I2C_ID = 0
I2C_SCL_PIN = 5
I2C_SDA_PIN = 4
OLED_WIDTH = 128
OLED_HEIGHT = 64
OLED_ADDR = 0x3C

# Built-in WS2812 on Waveshare ESP32-S3 Zero
LED_PIN = 21
LED_COUNT = 1
# Most WS2812 LEDs are GRB on the wire.
LED_COLOR_ORDER = "GRB"

# Wi-Fi mode: "sta" or "ap"
WIFI_MODE = "sta"
WIFI_SSID = "YOUR_WIFI_SSID"
WIFI_PASSWORD = "YOUR_WIFI_PASSWORD"

AP_SSID = "AIHarnessDesktopBuddy"
AP_PASSWORD = "buddybuddy"
