# Copy this file to config.py on the device and edit as needed.

DEVICE_NAME = "AIHarnessDesktopBuddy"
HTTP_PORT = 80

# I2C OLED pins
I2C_ID = 0
I2C_SCL_PIN = 5
I2C_SDA_PIN = 4
OLED_WIDTH = 128
OLED_HEIGHT = 64
OLED_ADDR = 0x3C

# Built-in WS2812 on Waveshare ESP32-S3 Zero
LED_PIN = 21
LED_COUNT = 1
# Most WS2812 LEDs are GRB on the wire.
LED_COLOR_ORDER = "GRB"
LED_PULSE_PERIOD_MS = 9000
LED_PULSE_HOLD_OFF_MS = 3000

# Wi-Fi mode: "sta" or "ap"
WIFI_MODE = "sta"
WIFI_SSID = "YOUR_WIFI_SSID"
WIFI_PASSWORD = "YOUR_WIFI_PASSWORD"
WIFI_SECURITY = "wpa2"

AP_SSID = "DesktopBuddy"
AP_PASSWORD = "buddybuddy"

# Optional clock settings for the periodic time/date overlay.
CLOCK_OVERLAY_ENABLED = True
CLOCK_OVERLAY_INTERVAL_MINUTES = 5
CLOCK_OVERLAY_DURATION_SECONDS = 60
TIMEZONE_OFFSET_SECONDS = 0
NTP_HOST = "pool.ntp.org"

# Async event queue history.
EVENT_HISTORY_LIMIT = 32

# After this many seconds without API activity, switch to the idle face.
API_IDLE_TIMEOUT_SECONDS = 900
API_IDLE_FACE = "sleepy"
